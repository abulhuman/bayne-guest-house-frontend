{
  "name": "admin-add-staff",
  "role": "admin",
  "demo": {
    "group": "admin",
    "title": "Add a staff member",
    "summary": "The admin adds a new receptionist with a login account and hands over a one-time password."
  },
  "setup": [
    { "as": "admin", "method": "POST", "path": "/staff", "body": { "name": "Fadumo Ali", "role": "housekeeping", "phone": "0911234567" }, "expect": 201 },
    { "as": "admin", "method": "POST", "path": "/staff", "body": { "name": "Abdullahi Yusuf", "role": "security", "phone": "0922345678", "emergencyContact": "Osman Mohamed 0911987654" }, "expect": 201 }
  ],
  "steps": [
    { "goto": "/staff" },
    { "caption": "Add a new hire from the Staff page." },
    { "click": { "role": "button", "name": "Add Staff" } },
    { "caption": "Step 1. Details and a login email." },
    { "fill": { "label": "Full name" }, "value": "Hodan Ahmed" },
    { "select": { "label": "Role" }, "value": "reception" },
    { "fill": { "label": "Phone" }, "value": "0913456789" },
    { "fill": { "label": "Emergency contact (optional)" }, "value": "Ahmed Ali 0911556677" },
    { "fill": { "label": "Email" }, "value": "hodan.${RUN}@almis.et" },
    { "click": { "role": "button", "name": "Continue" } },
    { "poster": true },
    { "caption": "Step 2. Review the one-time password." },
    { "click": { "role": "button", "name": "Create Staff & Account" } },
    { "expectApi": "POST /staff 201" },
    { "expectText": "Staff created" },
    { "caption": "It shows only once. Save it first." },
    { "click": { "label": "I saved the password" } },
    { "click": { "role": "button", "name": "Done" } },
    { "expectHidden": { "role": "dialog", "name": "Review & Create" } },
    { "expectText": "hodan.${RUN}@almis.et" },
    { "caption": "Hodan is listed with her login." },
    { "apiCheck": { "as": "admin", "path": "/staff", "jq": "any(.[]; .name == \"Hodan Ahmed\" and .user.email == \"hodan.${RUN}@almis.et\" and .user.role == \"reception\")" } }
  ]
}
