{
  "name": "reception-tour",
  "role": "anon",
  "demo": {
    "group": "reception",
    "as": "reception",
    "title": "Reception sign-in tour",
    "summary": "Reception signs in and sees 8 pages: Dashboard, Bookings, Laundry, Attendance, Payments, Inventory, Rooms, Guests."
  },
  "setup": [
    { "as": "reception", "method": "GET", "path": "/auth/me", "expect": 200 }
  ],
  "steps": [
    { "goto": "/login" },
    { "caption": "Reception staff sign in with their work email and password." },
    { "fill": { "placeholder": "you@example.com" }, "value": "verify-reception@example.com" },
    { "fill": { "placeholder": "••••••••" }, "value": "verify-pass-reception" },
    { "click": { "role": "button", "name": "Sign in" } },
    { "expectApi": "POST /auth/login 201" },
    { "expectUrl": "/dashboard" },
    { "caption": "Reception lands on Dashboard. Hotel totals at a glance." },
    { "click": "aside nav a:text-is('Bookings')" },
    { "expectUrl": "/bookings" },
    { "caption": "Bookings. Every guest stay." },
    { "click": "aside nav a:text-is('Laundry')" },
    { "expectUrl": "/laundry" },
    { "caption": "Laundry. Guest laundry orders." },
    { "click": "aside nav a:text-is('Attendance')" },
    { "expectUrl": "/attendance" },
    { "caption": "Attendance. Staff hours worked." },
    { "click": "aside nav a:text-is('Payments')" },
    { "expectUrl": "/payments" },
    { "caption": "Payments. Record payments, see unpaid stays." },
    { "poster": true },
    { "click": "aside nav a:text-is('Inventory')" },
    { "expectUrl": "/inventory" },
    { "caption": "Inventory. Stock levels and changes." },
    { "click": "aside nav a:text-is('Rooms')" },
    { "expectUrl": "/rooms" },
    { "caption": "Rooms. Numbers, types and prices." },
    { "click": "aside nav a:text-is('Guests')" },
    { "expectUrl": "/guests" },
    { "caption": "Guests. Guest profiles." },
    { "click": { "role": "button", "name": "Logout" } },
    { "expectUrl": "/login" }
  ]
}
