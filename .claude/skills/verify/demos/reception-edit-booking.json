{
  "name": "reception-edit-booking",
  "role": "reception",
  "demo": {
    "group": "reception",
    "title": "Change a booking",
    "summary": "Reception extends a guest's stay by a night and moves them to another room."
  },
  "setup": [
    { "as": "admin", "method": "POST", "path": "/rooms", "body": { "number": "112", "type": "single", "price": 1200 }, "expect": 201, "save": "R1" },
    { "as": "admin", "method": "POST", "path": "/rooms", "body": { "number": "113", "type": "double", "price": 1800 }, "expect": 201, "save": "R2" },
    { "as": "reception", "method": "POST", "path": "/guests", "body": { "name": "Safiya Hassan", "phone": "0913667788" }, "expect": 201, "save": "G" },
    { "as": "reception", "method": "POST", "path": "/bookings", "body": { "guestId": "${G}", "roomId": "${R1}", "checkIn": "${DATE+5}", "checkOut": "${DATE+7}" }, "expect": 201, "save": "BK" }
  ],
  "steps": [
    { "goto": "/bookings" },
    { "caption": "Safiya called to stay one more night and wants a double room." },
    { "click": "tr:has-text('112 — single') >> role=button[name='Edit']" },
    { "expectText": "Edit Booking" },
    { "poster": true },
    { "caption": "Move the check-out one day later." },
    { "fill": { "label": "Check-out" }, "value": "${DATE+8}" },
    { "caption": "Pick a room that is free for the new dates." },
    { "select": { "label": "Available Rooms" }, "value": "${R2}" },
    { "click": { "role": "button", "name": "Save Changes" } },
    { "expectApi": "PATCH /bookings/${BK} 200" },
    { "expectText": "Booking updated successfully" },
    { "expectText": "113 — double" },
    { "caption": "The list shows the new room and dates." },
    { "apiCheck": { "as": "reception", "path": "/bookings", "jq": "any(.[]; .id == ${BK} and .roomId == ${R2})" } }
  ]
}
