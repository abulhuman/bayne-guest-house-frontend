{
  "name": "admin-search-staff",
  "role": "admin",
  "demo": {
    "group": "admin",
    "title": "Search staff",
    "summary": "The admin filters the staff list to see who works in housekeeping."
  },
  "setup": [
    { "as": "admin", "method": "POST", "path": "/staff", "body": { "name": "Hawa Osman", "role": "reception", "phone": "0919012345" }, "expect": 201 },
    { "as": "admin", "method": "POST", "path": "/staff", "body": { "name": "Abdirizak Hassan", "role": "security", "phone": "0920123456" }, "expect": 201 },
    { "as": "admin", "method": "POST", "path": "/staff", "body": { "name": "Ifrah Abdi", "role": "housekeeping", "phone": "0921234567" }, "expect": 201 },
    { "as": "admin", "method": "POST", "path": "/staff", "body": { "name": "Omar Ibrahim", "role": "housekeeping", "phone": "0923456789" }, "expect": 201 }
  ],
  "steps": [
    { "goto": "/staff" },
    { "expectApi": "GET /staff 200" },
    { "caption": "Search by name, role, phone, barcode or email." },
    { "fill": { "placeholder": "Search name, role, phone, barcode, email…" }, "value": "housekeeping" },
    { "expectText": "Ifrah Abdi" },
    { "expectText": "Omar Ibrahim" },
    { "expectNoText": "Abdirizak Hassan" },
    { "click": "tr:has-text('Ifrah Abdi') >> input[type='checkbox']" },
    { "expectText": "Print selected (1)" },
    { "caption": "Only the housekeeping team is left in the list." },
    { "caption": "A phone number works as well." },
    { "fill": { "placeholder": "Search name, role, phone, barcode, email…" }, "value": "0919012345" },
    { "expectText": "Hawa Osman" },
    { "expectNoText": "Ifrah Abdi" },
    { "caption": "Open the one result to confirm it is the right staff record." },
    { "click": "tr:has-text('Hawa Osman') >> role=button[name='Edit']" },
    { "expectVisible": { "role": "dialog", "name": "Edit Staff" } },
    { "click": { "role": "button", "name": "Cancel" } },
    { "click": "tr:has-text('Hawa Osman') >> role=button[name='ID card']" },
    { "expectVisible": { "role": "dialog", "name": "ID card" } },
    { "wait": 1500 },
    { "poster": true },
    { "click": { "role": "button", "name": "Close" } },
    { "apiCheck": { "as": "admin", "path": "/staff", "jq": "any(.[]; .name == \"Ifrah Abdi\" and .role == \"housekeeping\")" } }
  ]
}
