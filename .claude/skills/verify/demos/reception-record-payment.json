{
  "name": "reception-record-payment",
  "role": "reception",
  "demo": {
    "group": "reception",
    "title": "Record a booking payment",
    "summary": "Reception records a guest's payment for a booking, and the app works out the total from the nights and the room rate."
  },
  "setup": [
    { "as": "reception", "method": "POST", "path": "/guests", "body": { "name": "Sumaya Ali", "phone": "0911456723" }, "expect": 201, "save": "GUEST1" },
    { "as": "reception", "method": "POST", "path": "/guests", "body": { "name": "Yasin Hassan", "phone": "0922318845" }, "expect": 201, "save": "GUEST2" },
    { "as": "reception", "method": "POST", "path": "/guests", "body": { "name": "Maryan Osman", "phone": "0913775520" }, "expect": 201, "save": "GUEST3" },
    { "as": "admin", "method": "POST", "path": "/rooms", "body": { "number": "330", "type": "double", "price": 1800 }, "expect": 201, "save": "ROOM1" },
    { "as": "admin", "method": "POST", "path": "/rooms", "body": { "number": "331", "type": "single", "price": 1200 }, "expect": 201, "save": "ROOM2" },
    { "as": "admin", "method": "POST", "path": "/rooms", "body": { "number": "332", "type": "suite", "price": 3500 }, "expect": 201, "save": "ROOM3" },
    { "as": "reception", "method": "POST", "path": "/bookings", "body": { "guestId": "${GUEST1}", "roomId": "${ROOM1}", "checkIn": "${DATE+1}", "checkOut": "${DATE+4}" }, "expect": 201, "save": "BOOKING1" },
    { "as": "reception", "method": "POST", "path": "/bookings", "body": { "guestId": "${GUEST2}", "roomId": "${ROOM2}", "checkIn": "${DATE+0}", "checkOut": "${DATE+2}" }, "expect": 201, "save": "BOOKING2" },
    { "as": "reception", "method": "POST", "path": "/bookings", "body": { "guestId": "${GUEST3}", "roomId": "${ROOM3}", "checkIn": "${DATE+2}", "checkOut": "${DATE+3}" }, "expect": 201, "save": "BOOKING3" },
    { "as": "reception", "method": "POST", "path": "/payments", "body": { "bookingId": "${BOOKING2}", "method": "cash", "status": "paid" }, "expect": 201 },
    { "as": "reception", "method": "POST", "path": "/payments", "body": { "bookingId": "${BOOKING3}", "method": "card", "status": "paid" }, "expect": 201 }
  ],
  "steps": [
    { "goto": "/payments" },
    { "caption": "The Payments page lists every payment taken. Record a new one." },
    { "click": { "role": "button", "name": "Record Payment" } },
    { "caption": "Step 1. Pick the guest's booking." },
    { "select": { "label": "Booking" }, "value": "${BOOKING1}" },
    { "expectText": "ETB\u00a01,800.00 = ETB\u00a05,400.00" },
    { "caption": "The total is worked out from 3 nights at the room rate." },
    { "caption": "Step 2. Say how the guest paid." },
    { "select": { "label": "Method" }, "value": "cbe" },
    { "select": { "label": "Status" }, "value": "paid" },
    { "fill": { "label": "Description / Reason (optional)" }, "value": "Paid in full by CBE transfer at check-in" },
    { "caption": "Step 3. Save the payment." },
    { "click": { "role": "button", "name": "Record" } },
    { "expectApi": "POST /payments 201" },
    { "expectHidden": "role=dialog" },
    { "expectVisible": "tr:has-text('Sumaya Ali'):has-text('ETB\u00a05,400.00'):has-text('CBE Transfer') >> nth=0" },
    { "caption": "The payment is now at the top of the list." },
    { "apiCheck": { "as": "reception", "path": "/payments", "jq": "any(.[]; .bookingId == ${BOOKING1} and .amount == 5400 and .status == \"paid\" and .method == \"cbe\")" } }
  ]
}
