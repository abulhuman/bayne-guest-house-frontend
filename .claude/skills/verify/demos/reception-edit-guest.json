{
  "name": "reception-edit-guest",
  "role": "reception",
  "demo": {
    "group": "reception",
    "title": "Update a guest's phone",
    "summary": "Reception changes a returning guest's phone number on their profile."
  },
  "setup": [
    { "as": "reception", "method": "POST", "path": "/guests", "body": { "name": "Fadumo Yusuf", "phone": "0914556677", "email": "fadumo.${RUN}@example.com" }, "expect": 201, "save": "G" }
  ],
  "steps": [
    { "goto": "/guests" },
    { "caption": "Fadumo has a new phone number. Search for her, then click Edit." },
    { "fill": { "placeholder": "Search guests…" }, "value": "Fadumo" },
    { "click": "tr:has-text('fadumo.${RUN}@example.com') >> role=button[name='Edit']" },
    { "expectText": "Edit Guest" },
    { "poster": true },
    { "expectValue": { "label": "Phone" }, "value": "0914556677" },
    { "caption": "Replace the old number and save." },
    { "fill": { "label": "Phone" }, "value": "0914998877" },
    { "click": { "role": "button", "name": "Save changes" } },
    { "expectApi": "PATCH /guests/${G} 200" },
    { "expectText": "0914998877" },
    { "caption": "The list shows the new number." },
    { "apiCheck": { "as": "reception", "path": "/guests/${G}", "jq": ".phone == \"0914998877\" and .name == \"Fadumo Yusuf\"" } }
  ]
}
