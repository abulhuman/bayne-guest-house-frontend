{
  "name": "store-tour",
  "role": "anon",
  "demo": {
    "group": "store",
    "as": "store",
    "title": "Store sign-in tour",
    "summary": "Store signs in and sees one page: Inventory."
  },
  "setup": [
    { "as": "store", "method": "GET", "path": "/auth/me", "expect": 200 }
  ],
  "steps": [
    { "goto": "/login" },
    { "caption": "Store staff sign in with their work email and password." },
    { "fill": { "placeholder": "you@example.com" }, "value": "verify-store@example.com" },
    { "fill": { "placeholder": "••••••••" }, "value": "verify-pass-store" },
    { "click": { "role": "button", "name": "Sign in" } },
    { "expectApi": "POST /auth/login 201" },
    { "expectUrl": "/inventory" },
    { "caption": "Store lands on Inventory. Stock levels and changes." },
    { "poster": true },
    { "click": { "role": "button", "name": "Logout" } },
    { "expectUrl": "/login" }
  ]
}
