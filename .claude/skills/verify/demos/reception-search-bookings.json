{
  "name": "reception-search-bookings",
  "role": "reception",
  "demo": {
    "group": "reception",
    "title": "Search bookings",
    "summary": "Reception finds a booking fast by typing a guest name or room number in the search box."
  },
  "setup": [
    { "as": "admin", "method": "POST", "path": "/rooms", "body": { "number": "114", "type": "single", "price": 1200 }, "expect": 201, "save": "R1" },
    { "as": "admin", "method": "POST", "path": "/rooms", "body": { "number": "115", "type": "double", "price": 1800 }, "expect": 201, "save": "R2" },
    { "as": "admin", "method": "POST", "path": "/rooms", "body": { "number": "116", "type": "suite", "price": 3500 }, "expect": 201, "save": "R3" },
    { "as": "reception", "method": "POST", "path": "/guests", "body": { "name": "Abdirahman Mohamed", "phone": "0915112233" }, "expect": 201, "save": "G1" },
    { "as": "reception", "method": "POST", "path": "/guests", "body": { "name": "Sahra Ahmed", "phone": "0915223344" }, "expect": 201, "save": "G2" },
    { "as": "reception", "method": "POST", "path": "/guests", "body": { "name": "Asha Yusuf", "phone": "0915334455" }, "expect": 201, "save": "G3" },
    { "as": "reception", "method": "POST", "path": "/bookings", "body": { "guestId": "${G1}", "roomId": "${R1}", "checkIn": "${DATE+1}", "checkOut": "${DATE+3}" }, "expect": 201 },
    { "as": "reception", "method": "POST", "path": "/bookings", "body": { "guestId": "${G2}", "roomId": "${R2}", "checkIn": "${DATE+2}", "checkOut": "${DATE+4}" }, "expect": 201 },
    { "as": "reception", "method": "POST", "path": "/bookings", "body": { "guestId": "${G3}", "roomId": "${R3}", "checkIn": "${DATE+3}", "checkOut": "${DATE+6}" }, "expect": 201 }
  ],
  "steps": [
    { "goto": "/bookings" },
    { "expectApi": "GET /bookings 200" },
    { "expectText": "Abdirahman Mohamed" },
    { "expectText": "Sahra Ahmed" },
    { "caption": "The list grows long. Use the search box to find one booking." },
    { "fill": { "placeholder": "Search by guest, room, date…" }, "value": "Sahra" },
    { "expectText": "Sahra Ahmed" },
    { "expectNoText": "Abdirahman Mohamed" },
    { "expectNoText": "Asha Yusuf" },
    { "caption": "Typing a guest name keeps only that guest's bookings." },
    { "fill": { "placeholder": "Search by guest, room, date…" }, "value": "116" },
    { "expectText": "Asha Yusuf" },
    { "expectNoText": "Sahra Ahmed" },
    { "poster": true },
    { "caption": "A room number works too." },
    { "fill": { "placeholder": "Search by guest, room, date…" }, "value": "" },
    { "expectText": "Abdirahman Mohamed" },
    { "caption": "Clear the box to see every booking again." }
  ]
}
