{
  "name": "manager-add-room",
  "role": "manager",
  "demo": {
    "group": "manager",
    "title": "Add a room",
    "summary": "The manager adds a new room with its type and nightly price so reception can book it."
  },
  "setup": [
    { "as": "manager", "method": "POST", "path": "/rooms", "body": { "number": "501", "type": "Single", "price": 1200 }, "expect": 201 },
    { "as": "manager", "method": "POST", "path": "/rooms", "body": { "number": "502", "type": "Double", "price": 1800 }, "expect": 201 }
  ],
  "steps": [
    { "goto": "/rooms" },
    { "caption": "The Rooms page lists every room with its nightly price." },
    { "click": { "role": "button", "name": "Add Room" } },
    { "click": { "role": "button", "name": "Add Room" } },
    { "expectText": "Room number is required" },
    { "poster": true },
    { "caption": "Enter the room number, type and price in birr." },
    { "fill": { "label": "Number" }, "value": "503" },
    { "fill": { "label": "Type" }, "value": "Suite" },
    { "fill": { "label": "Price" }, "value": "3500" },
    { "click": { "role": "button", "name": "Add Room" } },
    { "expectApi": "POST /rooms 201" },
    { "expectHidden": { "role": "dialog", "name": "Add Room" } },
    { "expectText": "ETB\u00a03,500.00" },
    { "fill": { "placeholder": "Search…" }, "value": "503" },
    { "expectVisible": "tr:has-text('503'):has-text('ETB\u00a03,500.00')" },
    { "caption": "Room 503 is in the list and ready to book." },
    { "apiCheck": { "as": "manager", "path": "/rooms", "jq": "any(.[]; .number == \"503\" and .type == \"Suite\" and .price == 3500)" } }
  ]
}
