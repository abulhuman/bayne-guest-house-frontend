{
  "name": "finance-tour",
  "role": "anon",
  "demo": {
    "group": "finance",
    "as": "finance",
    "title": "Finance sign-in tour",
    "summary": "Finance signs in and sees 2 pages: Dashboard, Payments."
  },
  "setup": [
    { "as": "finance", "method": "GET", "path": "/auth/me", "expect": 200 }
  ],
  "steps": [
    { "goto": "/login" },
    { "caption": "Finance staff sign in with their work email and password." },
    { "fill": { "placeholder": "you@example.com" }, "value": "verify-finance@example.com" },
    { "fill": { "placeholder": "••••••••" }, "value": "verify-pass-finance" },
    { "click": { "role": "button", "name": "Sign in" } },
    { "expectApi": "POST /auth/login 201" },
    { "expectUrl": "/dashboard" },
    { "caption": "Finance lands on Dashboard. Hotel totals at a glance." },
    { "click": "aside nav a:text-is('Payments')" },
    { "expectUrl": "/payments" },
    { "click": "aside nav a:text-is('Dashboard')" },
    { "expectUrl": "/dashboard" },
    { "fill": { "label": "Start" }, "value": "${DATE-6}" },
    { "fill": { "label": "End" }, "value": "${DATE+0}" },
    { "click": { "role": "button", "name": "Apply" } },
    { "expectApi": "GET /stats/overview 200" },
    { "caption": "Review the last seven days before opening the payment ledger." },
    { "poster": true },
    { "click": { "role": "button", "name": "Logout" } },
    { "expectUrl": "/login" }
  ]
}
