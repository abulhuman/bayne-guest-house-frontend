{
  "name": "reception-booking-new-guest",
  "role": "reception",
  "demo": {
    "group": "reception",
    "title": "Book a first-time guest",
    "summary": "Reception books a room for a walk-in guest who is not in the system yet, adding the guest inside the booking."
  },
  "setup": [
    { "as": "admin", "method": "POST", "path": "/rooms", "body": { "number": "111", "type": "single", "price": 1200 }, "expect": 201, "save": "ROOM" }
  ],
  "steps": [
    { "goto": "/bookings" },
    { "caption": "A new guest walks in. Start a booking from the Bookings page." },
    { "click": { "role": "button", "name": "Create Booking" } },
    { "caption": "Step 1. The guest is new, so add their details here." },
    { "click": { "role": "button", "name": "New guest" } },
    { "fill": { "label": "Full name" }, "value": "Abdi Omar" },
    { "fill": { "label": "Phone" }, "value": "0922334455" },
    { "click": { "role": "button", "name": "Next" } },
    { "expectNoApi": "POST /guests" },
    { "caption": "Step 2. Choose the dates and a free room." },
    { "fill": { "label": "Check-in" }, "value": "${DATE+2}" },
    { "fill": { "label": "Check-out" }, "value": "${DATE+4}" },
    { "select": { "label": "Room" }, "value": "${ROOM}" },
    { "click": { "role": "button", "name": "Next" } },
    { "expectText": "Abdi Omar — 0922334455 (new)" },
    { "caption": "Step 3. Review. The guest is marked new and gets saved with the booking." },
    { "poster": true },
    { "click": { "role": "button", "name": "Create booking" } },
    { "expectApi": "POST /guests 201" },
    { "expectApi": "POST /bookings 201" },
    { "expectText": "Booking created successfully" },
    { "expectText": "Abdi Omar" },
    { "caption": "The booking and the new guest are both saved." },
    { "apiCheck": { "as": "reception", "path": "/bookings", "jq": "any(.[]; .guest.name == \"Abdi Omar\" and .roomId == ${ROOM})" } }
  ]
}
