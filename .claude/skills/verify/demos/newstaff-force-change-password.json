{
  "name": "newstaff-force-change-password",
  "role": "anon",
  "demo": {
    "group": "sign-in",
    "as": "New staff",
    "title": "First sign-in password change",
    "summary": "A new receptionist signs in with the password the admin gave them and must choose their own before using the app."
  },
  "setup": [
    { "as": "admin", "method": "POST", "path": "/staff", "body": { "name": "Maryan Osman", "role": "reception", "phone": "0912345678", "username": "maryan.${RUN}@example.com", "password": "Welcome123", "forceChangePassword": true }, "expect": 201 }
  ],
  "steps": [
    { "goto": "/login" },
    { "caption": "Maryan just joined reception. The admin gave her a temporary password." },
    { "fill": { "placeholder": "you@example.com" }, "value": "maryan.${RUN}@example.com" },
    { "fill": { "placeholder": "••••••••" }, "value": "Welcome123" },
    { "click": { "role": "button", "name": "Sign in" } },
    { "expectApi": "POST /auth/login 201" },
    { "expectUrl": "/change-password" },
    { "expectText": "Choose a new password to continue." },
    { "caption": "The app sends her straight to Change password. No other page opens until she does." },
    { "fill": { "label": "Current password" }, "value": "Welcome123" },
    { "fill": { "label": "New password" }, "value": "NewPass2026!" },
    { "click": { "role": "button", "name": "Change password" } },
    { "expectApi": "POST /auth/change-password" },
    { "expectText": "Password changed" },
    { "expectUrl": "/dashboard" },
    { "caption": "Password saved. She lands on the reception dashboard." },
    { "caption": "Her new password now works at sign-in." },
    { "click": { "role": "button", "name": "Logout" } },
    { "expectUrl": "/login" },
    { "fill": { "placeholder": "you@example.com" }, "value": "maryan.${RUN}@example.com" },
    { "fill": { "placeholder": "••••••••" }, "value": "NewPass2026!" },
    { "click": { "role": "button", "name": "Sign in" } },
    { "expectUrl": "/dashboard" },
    { "expectApi": "POST /auth/login 201" }
  ]
}
