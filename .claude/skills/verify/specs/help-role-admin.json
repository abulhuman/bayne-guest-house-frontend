{
  "name": "help-role-admin",
  "role": "admin",
  "steps": [
    {
      "goto": "/help"
    },
    {
      "expectApi": "GET /tutorials 200"
    },
    {
      "expectText": "Search guides"
    },
    {
      "expectNoText": "No guides are available yet."
    },
    {
      "expectVisible": "h2:text-is(\"Staff\")"
    },
    {
      "expectVisible": "button:text-is(\"Play tour\")"
    },
    {
      "click": "button:text-is(\"Play tour\")"
    },
    {
      "expectVisible": "[role=\"dialog\"] h3:text-is(\"Admin sign-in tour\")"
    },
    {
      "press": "Escape"
    },
    {
      "expectHidden": "[role=\"dialog\"]"
    },
    {
      "expectVisible": "li button:has-text(\"Add a staff member\")"
    },
    {
      "click": "summary:text-is(\"Other roles\")"
    },
    {
      "expectVisible": "details li button:has-text(\"Create a booking\")"
    },
    {
      "expectVisible": "details li button:has-text(\"Take stock for coffee service\")"
    },
    {
      "expectVisible": "details li button:has-text(\"Review payments\")"
    },
    {
      "expectVisible": "details li button:has-text(\"Update a laundry order\")"
    },
    {
      "expectNoPageErrors": true
    },
    {
      "screenshot": "help-admin"
    }
  ]
}
